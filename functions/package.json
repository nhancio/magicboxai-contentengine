{
  "name": "functions",
  "description": "Firebase Cloud Functions for MagicBox AI",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && node --test test/*.test.cjs test/video/*.test.cjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^1.46.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "luxon": "^3.5.0",
    "node-fetch": "^3.3.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
