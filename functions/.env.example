# Non-secret runtime config for Cloud Functions (safe to commit).
# Secrets (API keys / client secrets) are NOT here — set them with
# `firebase functions:secrets:set <NAME>`. See CHANNELS_SETUP.md.

# Where the app lives; the OAuth callback redirects here afterwards.
APP_BASE_URL=https://app.magicboxai.in
LANDING_BASE_URL=https://magicboxai.in

# Dodo runtime mode and product catalogue. Keep test/live projects separate.
DODO_MODE=test
DODO_BUSINESS_ID=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_MAX_MONTHLY=
DODO_PRODUCT_MAX_ANNUAL=

# DODO_API_KEY and DODO_WEBHOOK_SECRET are secrets. Configure them with:
# firebase functions:secrets:set DODO_API_KEY
# firebase functions:secrets:set DODO_WEBHOOK_SECRET

# Public HTTPS URL of the socialOAuthCallback function. Must match the redirect
# URI registered in the Meta and LinkedIn app dashboards EXACTLY.
# After first deploy, copy the deployed function URL here and redeploy.
OAUTH_CALLBACK_URL=https://us-central1-magicboxai-50927.cloudfunctions.net/socialOAuthCallback
