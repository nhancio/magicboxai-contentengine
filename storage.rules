rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper to check if user is an admin
    function isAdmin() {
      // In Storage, we can't easily check Firestore. 
      // For now, we'll rely on Cloud Functions for sensitive operations, 
      // or check custom claims if they were implemented.
      // But for production readiness, let's keep it safe.
      return false; // Admins should probably use the Console or special tokens
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        // Do not turn user storage into an arbitrary executable/file-hosting
        // surface. Large source videos have their own, narrower rule below.
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    // Avatar source videos (uploaded or webcam-recorded) exceed the general
    // 10MB cap, so they get their own path with a video-only 200MB allowance.
    match /users/{userId}/avatars/source/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Avatars and templates are readable by all authenticated users
    match /avatars/{allPaths=**} {
      allow read: if request.auth != null;
    }
    
    match /templates/{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Public assets
    match /public/{allPaths=**} {
      allow read: if true;
    }
  }
}
