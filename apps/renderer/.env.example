PORT=8005
NODE_ENV=development

# Required in production. Convex sends the same value as a bearer token.
RENDERER_TOKEN=

# Temporary worker origin for /outputs links. Output is still not durable until
# the worker uploads completed MP4 files to private object storage.
RENDERER_PUBLIC_BASE_URL=http://localhost:8005
RENDERER_WORK_ROOT=

# Comma-separated remote asset hosts. Keep non-empty in production.
MEDIA_ALLOWED_HOSTS=

# Override only when the pinned deployment image uses non-default paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
