# =============================================================================
# Firebase – required for sign-in, Firestore, and Storage
# Get these from: Firebase Console → Project settings → Your apps → Web app config
# =============================================================================
VITE_FIREBASE_API_KEY=
# Local/dev: use <project>.firebaseapp.com.
# Production (app.magicboxai.in): use the app host itself — apps/web/vercel.json
# proxies /__/auth/* so the sign-in handler is first-party, which is what makes
# redirect sign-in and token refresh survive Safari/ITP. See FIREBASE_SETUP.md
# ("Self-hosted sign-in handler") for the one-time OAuth redirect-URI step.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console -> App Check -> reCAPTCHA Enterprise site key. This is
# required because all browser-callable Cloud Functions enforce App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# =============================================================================
# Convex – reactive backend (self-hosted on GCP or Convex Cloud)
# =============================================================================
VITE_CONVEX_URL=http://136.107.79.221:3210

# =============================================================================
# Feedback System – optional; Google Apps Script / Sheets webhook URL
# =============================================================================
VITE_FEEDBACK_WEBHOOK_URL=

# =============================================================================
# Analytics (PostHog) – optional; module no-ops when unset
# =============================================================================
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional convenience link shown in the admin Product Analytics page.
VITE_POSTHOG_PROJECT_URL=

# =============================================================================
# Cloud Functions – non-secret config, set in functions/.env
# =============================================================================
# Where users land after OAuth / checkout round-trips
APP_BASE_URL=https://app.magicboxai.in
# Public URL of the socialOAuthCallback function (register it at Meta/LinkedIn/Google)
OAUTH_CALLBACK_URL=
# Dodo Payments: "test" (default) or "live"
DODO_MODE=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# =============================================================================
# Cloud Functions – secrets, set via `firebase functions:secrets:set NAME`
# (listed here for reference only — never commit values)
# =============================================================================
# META_APP_ID / META_APP_SECRET               – Instagram (Meta Graph API)
# LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET – LinkedIn
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET – YouTube (Google OAuth)
# OAUTH_STATE_SECRET                          – any long random string
# BREVO_API_KEY                               – transactional email
