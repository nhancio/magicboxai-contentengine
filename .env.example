# =============================================================================
# Firebase – required for sign-in, Firestore, and Storage
# Get these from: Firebase Console → Project settings → Your apps → Web app config
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# =============================================================================
# Razorpay – required for subscription payments
# Frontend uses the publishable key; Cloud Functions use the secret key pair.
# Get these from: Razorpay Dashboard → Settings → API Keys
# =============================================================================
VITE_RAZORPAY_KEY_ID=

# =============================================================================
# Cloud Functions / backend
# Set these in your Firebase Functions environment or secret manager,
# not in the frontend app.
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =============================================================================
# Post Bridge – social posting API (Instagram / Twitter-X / LinkedIn)
# Set as a Functions secret: firebase functions:secrets:set POST_BRIDGE_API_KEY
# When unset, the posting pipeline runs in dry-run sandbox mode.
# =============================================================================
POST_BRIDGE_API_KEY=
# Optional: force dry-run even with a key configured
POST_BRIDGE_DRY_RUN=
